{
  "name": "shiftdex",
  "version": "1.0.1",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "description": "24/7 shift roster admin desktop and worker portal",
  "author": "Shift Desk",
  "contributors": [
    {
      "name": "Antigravity",
      "email": "antigravity@google.com",
      "url": "https://deepmind.google"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Juny-max/Shiftdex.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/start-electron.cjs",
    "start": "node scripts/start-electron.cjs",
    "build": "vite build admin --base=./ --outDir ../dist/admin --emptyOutDir",
    "dist": "pnpm run build && node scripts/package-windows.cjs && node scripts/write-update-manifest.cjs",
    "web": "vite --host 0.0.0.0 --root worker",
    "worker:build": "vite build worker --base=./ --outDir dist --emptyOutDir",
    "worker:pages-deploy": "pnpm run worker:build && wrangler pages deploy worker/dist --project-name shiftdex-workers",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "set-brevo-key": "wrangler secret put BREVO_API_KEY --config worker/wrangler.toml",
    "admin:create": "node scripts/create-admin.cjs",
    "admin:reset-password": "node scripts/reset-admin-password.cjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "electron-updater": "^6.8.11",
    "lottie-web": "^5.13.0"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^26.0.0",
    "vite": "^6.4.6",
    "wrangler": "^4.165.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "build": {
    "appId": "com.shiftdesk.roster",
    "productName": "ShiftDex",
    "executableName": "ShiftDex",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/admin/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/shift-desk-mark.ico",
        "to": "shift-desk-mark.ico"
      }
    ],
    "win": {
      "icon": "assets/shift-desk-mark.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ShiftDex",
      "deleteAppDataOnUninstall": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Juny-max",
        "repo": "Shiftdex",
        "releaseType": "release"
      }
    ],
    "artifactName": "ShiftDex-Setup-${version}.${ext}"
  }
}
